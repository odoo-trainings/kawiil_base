<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view.inherit.cgun.module</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="cgun_test_field" />
                <field name="cgun_price" />
                <field name="cgun_tax" />
                <field name="cgun_total_price" />
                <field name="cgun_related"/>
            </xpath>

            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="string">New Category</attribute>
            </xpath>
        </field>
    </record>

</odoo>
