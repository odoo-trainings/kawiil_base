<odoo>

    <record id="training_test_view_form" model="ir.ui.view">
        <field name="model">training.test</field>
        <field name="name">training.test.view.form</field>
        <field name="arch" type="xml">
            <form>
                <sheet string="Training Test">
                    <group >
                        
                        <field name="name" />
                        <field name="test_selection"/>
                        <field name="product_id"/>
                        <field name="product_price" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="training_test_view_list" model="ir.ui.view">
        <field name="model">training.test</field>
        <field name="name">training.test.view.list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="test_selection"/>
                <field name="product_id"/>
                <field name="product_price" />
            </list>
        </field>
    </record>


    <record id="training_test_view_action" model="ir.actions.act_window">
        <field name="name">Training Test</field>
        <field name="view_mode">list,form</field>
        <field name="res_model">training.test</field>
    </record>

    <menuitem
        id="training_test_menu"
        name="Training Test"
        action="training_test_view_action"
        parent="sale.sale_order_menu"
        sequence="20"/>

</odoo>
