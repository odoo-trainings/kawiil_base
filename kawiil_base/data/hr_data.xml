<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Departments (managers are set once the employees exist, at the end of this file) -->
    <record id="hr_department_management" model="hr.department">
        <field name="name">Management</field>
        <field name="color" eval="5"/>
    </record>
    <record id="hr_department_sales" model="hr.department">
        <field name="name">Sales</field>
        <field name="parent_id" ref="hr_department_management"/>
        <field name="color" eval="9"/>
    </record>
    <record id="hr_department_assembly" model="hr.department">
        <field name="name">Assembly</field>
        <field name="parent_id" ref="hr_department_management"/>
        <field name="color" eval="2"/>
    </record>
    <record id="hr_department_after_sales" model="hr.department">
        <field name="name">After-sales Service</field>
        <field name="parent_id" ref="hr_department_management"/>
        <field name="color" eval="3"/>
    </record>
    <record id="hr_department_finance" model="hr.department">
        <field name="name">Finance</field>
        <field name="parent_id" ref="hr_department_management"/>
        <field name="color" eval="10"/>
    </record>

    <!-- Job positions -->
    <record id="hr_job_ceo" model="hr.job">
        <field name="name">Chief Executive Officer</field>
        <field name="department_id" ref="hr_department_management"/>
    </record>
    <record id="hr_job_sales_manager" model="hr.job">
        <field name="name">Sales Manager</field>
        <field name="department_id" ref="hr_department_sales"/>
    </record>
    <record id="hr_job_sales_rep" model="hr.job">
        <field name="name">Sales Representative</field>
        <field name="department_id" ref="hr_department_sales"/>
    </record>
    <record id="hr_job_assembly_manager" model="hr.job">
        <field name="name">Assembly Manager</field>
        <field name="department_id" ref="hr_department_assembly"/>
    </record>
    <record id="hr_job_assembly_technician" model="hr.job">
        <field name="name">Assembly Technician</field>
        <field name="department_id" ref="hr_department_assembly"/>
    </record>
    <record id="hr_job_service_manager" model="hr.job">
        <field name="name">After-sales Service Manager</field>
        <field name="department_id" ref="hr_department_after_sales"/>
    </record>
    <record id="hr_job_service_technician" model="hr.job">
        <field name="name">Service Technician</field>
        <field name="department_id" ref="hr_department_after_sales"/>
    </record>
    <record id="hr_job_customer_care" model="hr.job">
        <field name="name">Customer Care Specialist</field>
        <field name="department_id" ref="hr_department_after_sales"/>
    </record>
    <record id="hr_job_finance_manager" model="hr.job">
        <field name="name">Finance Manager</field>
        <field name="department_id" ref="hr_department_finance"/>
    </record>
    <record id="hr_job_accountant" model="hr.job">
        <field name="name">Accountant</field>
        <field name="department_id" ref="hr_department_finance"/>
    </record>

