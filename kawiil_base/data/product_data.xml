<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Categories -->
    <record id="product_category_motorcycles" model="product.category">
        <field name="name">Motorcycles</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>
    <record id="product_category_charging" model="product.category">
        <field name="name">Charging</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>
    <record id="product_category_rider_gear" model="product.category">
        <field name="name">Rider Gear</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>
    <record id="product_category_parts" model="product.category">
        <field name="name">Parts</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>

    <!-- Attributes: Battery is new, Color is the one shipped by the product module -->
    <record id="product_attribute_battery" model="product.attribute">
        <field name="name">Battery</field>
        <field name="display_type">radio</field>
        <field name="create_variant">always</field>
    </record>

    <record id="product_attribute_value_battery_raijin_std" model="product.attribute.value">
        <field name="name">Standard (15 kWh)</field>
        <field name="attribute_id" ref="product_attribute_battery"/>
        <field name="sequence">1</field>
    </record>
    <record id="product_attribute_value_battery_raijin_ext" model="product.attribute.value">
        <field name="name">Extended (20 kWh)</field>
        <field name="attribute_id" ref="product_attribute_battery"/>
        <field name="sequence">2</field>
    </record>
    <record id="product_attribute_value_battery_ukko_std" model="product.attribute.value">
        <field name="name">Standard (17 kWh)</field>
        <field name="attribute_id" ref="product_attribute_battery"/>
        <field name="sequence">1</field>
    </record>
    <record id="product_attribute_value_battery_ukko_ext" model="product.attribute.value">
        <field name="name">Extended (23 kWh)</field>
        <field name="attribute_id" ref="product_attribute_battery"/>
        <field name="sequence">2</field>
    </record>
    <record id="product_attribute_value_battery_indra_std" model="product.attribute.value">
        <field name="name">Standard (7 kWh)</field>
        <field name="attribute_id" ref="product_attribute_battery"/>
        <field name="sequence">1</field>
    </record>
    <record id="product_attribute_value_battery_indra_ext" model="product.attribute.value">
        <field name="name">Extended (11 kWh)</field>
        <field name="attribute_id" ref="product_attribute_battery"/>
        <field name="sequence">2</field>
    </record>

    <record id="product_attribute_value_color_jade_arc" model="product.attribute.value">
        <field name="name">Jade Arc</field>
        <field name="attribute_id" ref="product.pa_color"/>
        <field name="html_color">#0B7A64</field>
        <field name="sequence">1</field>
    </record>
    <record id="product_attribute_value_color_night_strike" model="product.attribute.value">
        <field name="name">Night Strike</field>
        <field name="attribute_id" ref="product.pa_color"/>
        <field name="html_color">#0A0F1F</field>
        <field name="sequence">2</field>
    </record>
    <record id="product_attribute_value_color_storm_white" model="product.attribute.value">
        <field name="name">Storm White</field>
        <field name="attribute_id" ref="product.pa_color"/>
        <field name="html_color">#E8ECEA</field>
        <field name="sequence">3</field>
    </record>

    <!-- K'awiil Raijin -->
    <record id="product_template_raijin" model="product.template">
        <field name="name">K'awiil Raijin</field>
        <field name="categ_id" ref="product_category_motorcycles"/>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="list_price">24000.0</field>
        <field name="description_sale">Flagship electric sport motorcycle.</field>
        <field name="image_1920" type="bytes" file="kawiil_base/static/img/products/raijin_jade_arc.jpg"/>
    </record>
    <!-- the attribute lines must exist before the variants can be named -->
    <record id="product_template_raijin_line_battery" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="product_template_raijin"/>
        <field name="attribute_id" ref="product_attribute_battery"/>
        <field name="value_ids" eval="[Command.set([ref('product_attribute_value_battery_raijin_std'), ref('product_attribute_value_battery_raijin_ext')])]"/>
    </record>
    <record id="product_template_raijin_line_color" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="product_template_raijin"/>
        <field name="attribute_id" ref="product.pa_color"/>
        <field name="value_ids" eval="[Command.set([ref('product_attribute_value_color_jade_arc'), ref('product_attribute_value_color_night_strike'), ref('product_attribute_value_color_storm_white')])]"/>
    </record>
    <!--
        Give xml ids to the product.template.attribute.value records generated by the
        attribute lines, to set their price_extra and to find the variants below.
    -->
    <function model="ir.model.data" name="_update_xmlids">
        <value model="base" eval="[{
            'xml_id': 'kawiil_base.product_template_raijin_value_battery_std',
            'record': obj().env['product.template.attribute.value'].search([('attribute_line_id', '=', ref('kawiil_base.product_template_raijin_line_battery')), ('product_attribute_value_id', '=', ref('kawiil_base.product_attribute_value_battery_raijin_std'))]),
            'noupdate': True,
        }, {
            'xml_id': 'kawiil_base.product_template_raijin_value_battery_ext',
            'record': obj().env['product.template.attribute.value'].search([('attribute_line_id', '=', ref('kawiil_base.product_template_raijin_line_battery')), ('product_attribute_value_id', '=', ref('kawiil_base.product_attribute_value_battery_raijin_ext'))]),
            'noupdate': True,
        }, {
            'xml_id': 'kawiil_base.product_template_raijin_value_color_jade_arc',
            'record': obj().env['product.template.attribute.value'].search([('attribute_line_id', '=', ref('kawiil_base.product_template_raijin_line_color')), ('product_attribute_value_id', '=', ref('kawiil_base.product_attribute_value_color_jade_arc'))]),
            'noupdate': True,
        }, {
            'xml_id': 'kawiil_base.product_template_raijin_value_color_night_strike',
            'record': obj().env['product.template.attribute.value'].search([('attribute_line_id', '=', ref('kawiil_base.product_template_raijin_line_color')), ('product_attribute_value_id', '=', ref('kawiil_base.product_attribute_value_color_night_strike'))]),
            'noupdate': True,
        }, {
            'xml_id': 'kawiil_base.product_template_raijin_value_color_storm_white',
            'record': obj().env['product.template.attribute.value'].search([('attribute_line_id', '=', ref('kawiil_base.product_template_raijin_line_color')), ('product_attribute_value_id', '=', ref('kawiil_base.product_attribute_value_color_storm_white'))]),
            'noupdate': True,
        }]"/>
    </function>
    <record id="product_template_raijin_value_battery_ext" model="product.template.attribute.value">
        <field name="price_extra">4500.0</field>
    </record>
    <function model="ir.model.data" name="_update_xmlids">
        <value model="base" eval="[{
            'xml_id': 'kawiil_base.product_raijin_15_jad',
            'record': obj().env.ref('kawiil_base.product_template_raijin')._get_variant_for_combination(obj().env.ref('kawiil_base.product_template_raijin_value_battery_std') + obj().env.ref('kawiil_base.product_template_raijin_value_color_jade_arc')),
            'noupdate': True,
        }, {
            'xml_id': 'kawiil_base.product_raijin_15_nst',
            'record': obj().env.ref('kawiil_base.product_template_raijin')._get_variant_for_combination(obj().env.ref('kawiil_base.product_template_raijin_value_battery_std') + obj().env.ref('kawiil_base.product_template_raijin_value_color_night_strike')),
            'noupdate': True,
        }, {
            'xml_id': 'kawiil_base.product_raijin_15_swh',
            'record': obj().env.ref('kawiil_base.product_template_raijin')._get_variant_for_combination(obj().env.ref('kawiil_base.product_template_raijin_value_battery_std') + obj().env.ref('kawiil_base.product_template_raijin_value_color_storm_white')),
