        }, {
            'xml_id': 'kawiil_base.product_raijin_20_jad',
            'record': obj().env.ref('kawiil_base.product_template_raijin')._get_variant_for_combination(obj().env.ref('kawiil_base.product_template_raijin_value_battery_ext') + obj().env.ref('kawiil_base.product_template_raijin_value_color_jade_arc')),
