<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Administrator: renamed the same way the base demo data renames it -->
    <record id="base.partner_admin" model="res.partner">
        <field name="name">Itzel Admin</field>
        <field name="function">CEO</field>
        <field name="email">itzel.admin@kawiil.example.com</field>
        <field name="phone">+1 555-0101</field>
        <field name="tz">America/Los_Angeles</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="signature" type="html"><div>Itzel Admin, CEO of K'awiil Motors</div></field>
    </record>

    <!-- Training users: passwords are listed in the README -->
    <record id="user_sales_manager" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Diego Ramírez</field>
        <field name="login">sales.manager</field>
        <field name="password">kawiil-manager</field>
        <field name="email">diego.ramirez@kawiil.example.com</field>
        <field name="phone">+1 555-0102</field>
        <field name="function">Sales Manager</field>
        <field name="tz">America/Los_Angeles</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
        <field name="group_ids" eval="[Command.set([
            ref('base.group_user'),
            ref('base.group_partner_manager'),
            ref('sales_team.group_sale_manager'),
        ])]"/>
    </record>

    <record id="user_sales_rep" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Hannah Lee</field>
        <field name="login">sales.rep</field>
        <field name="password">kawiil-rep</field>
        <field name="email">hannah.lee@kawiil.example.com</field>
        <field name="phone">+1 555-0103</field>
        <field name="function">Sales Representative</field>
        <field name="tz">America/Los_Angeles</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
        <field name="group_ids" eval="[Command.set([
            ref('base.group_user'),
            ref('base.group_partner_manager'),
            ref('sales_team.group_sale_salesman'),
        ])]"/>
    </record>

    <record id="user_finance" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Arjun Mehta</field>
        <field name="login">finance</field>
        <field name="password">kawiil-finance</field>
        <field name="email">arjun.mehta@kawiil.example.com</field>
        <field name="phone">+1 555-0104</field>
        <field name="function">Finance Manager</field>
        <field name="tz">America/Los_Angeles</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
        <field name="group_ids" eval="[Command.set([
            ref('base.group_user'),
            ref('base.group_partner_manager'),
            ref('account.group_account_manager'),
        ])]"/>
    </record>

    <!-- Both salespeople sell for the default sales team, led by the sales manager -->
    <record id="sales_team.team_sales_department" model="crm.team">
        <field name="user_id" ref="user_sales_manager"/>
        <field name="member_ids" eval="[Command.link(ref('user_sales_manager')), Command.link(ref('user_sales_rep'))]"/>
    </record>

</odoo>
