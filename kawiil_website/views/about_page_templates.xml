                        </div>
                        <div class="col-lg-3 pt32 pb32" data-name="Team Member">
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <div class="col-12 pb24 o_not_editable" contenteditable="false">
                                    <img alt="Tomás Herrera, Co-founder and Assembly Manager" src="/kawiil_base/static/img/employees/tomas.jpg" class="img-fluid o_editable_media w-100"/>
                                </div>
